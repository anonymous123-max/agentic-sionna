{
  "version": "2.0",
  "tier": "N1_single_ap_sim",
  "design": "Single-AP simulation on 4 Sionna built-in scenes \u00d7 2 sub-types (coverage map, point-level link probe) = 8 tasks. Natural-language prompts; all output schemas, filenames, RT-only invariants live in SKILL.md.",
  "verifier_strategy": "Layer A (artifacts) + Layer B (sionna_rt_used) + Layer C (n1_ref_oracle for coverage / n1_probe_oracle for link probe)",
  "count": 8,
  "tasks": [
    {
      "id": "N1_cov_box_two_screens",
      "tier": "N1_single_ap_sim",
      "sub_type": "coverage",
      "capability": "single_ap_coverage",
      "difficulty": "easy",
      "split": "train",
      "scene_name": "box_two_screens",
      "oracle_path": "benchmark/oracles/n1/box_two_screens.npy",
      "prompt": "Using Sionna's built-in box-with-two-screens indoor testbed, place a base-station transmitter at (0, 0, 4.5) m with 100 mW transmit power and isotropic antenna arrays. Generate the 5 GHz coverage map for this base station and return the map and visualization.",
      "required_artifacts": [
        "simulation.py",
        "coverage_map.npy",
        "coverage_map.png",
        "simulation_result.json"
      ],
      "verifier": {
        "type": "composite",
        "subchecks": [
          {
            "key": "must_create_simulation_py",
            "type": "file_exists",
            "path": "simulation.py"
          },
          {
            "key": "must_create_coverage_npy",
            "type": "file_exists",
            "path": "coverage_map.npy"
          },
