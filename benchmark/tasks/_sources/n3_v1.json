{
  "version": "1.0",
  "tier": "N3_multi_ap_sim",
  "design": "Multi-AP simulation on 4 Sionna built-in scenes, 2 APs per scene with symmetric placement. Agent must compute per-AP coverage, best-server map, and serving-AP assignment.",
  "verifier_strategy": "Layer A (artifacts) + Layer B (sionna_rt_used) + Layer C (n3_multi_ap_oracle: per-AP vs ref + best_server consistency + serving_ap consistency + metadata)",
  "count": 4,
  "tasks": [
    {
      "id": "N3_2ap_box_two_screens",
      "tier": "N3_multi_ap_sim",
      "capability": "multi_ap_sim",
      "difficulty": "easy",
      "split": "train",
      "scene_name": "box_two_screens",
      "ap_positions": [
        [
          -3,
          0,
          4.5
        ],
        [
          3,
          0,
          4.5
        ]
      ],
      "oracle_dir": "benchmark/oracles/n3_multi_ap/box_two_screens",
      "prompt": "Using Sionna's built-in box-with-two-screens indoor testbed, deploy two access points: AP 0 at (-3, 0, 4.5) m and AP 1 at (3, 0, 4.5) m, each transmitting 100 mW at 5 GHz with isotropic antennas. Compute the per-AP coverage maps, the joint best-server coverage map, and the serving-AP assignment for each cell.",
      "required_artifacts": [
        "simulation.py",
        "coverage_ap_0.npy",
        "coverage_ap_1.npy",
        "coverage_best_server.npy",
        "serving_ap_map.npy",
        "coverage_summary.png",
        "simulation_result.json"
      ],
