{#-
  mistral_tool.jinja — Mixtral/Mistral chat template that supports the full
  OpenAI message taxonomy (system, user, assistant, tool) and Mistral's native
  function-calling tags ([TOOL_CALLS] / [TOOL_RESULTS]).

  EDIT-TAG: mixtral-template-fix (2026-05) — drop-in via vllm --chat-template
  so Mixtral can handle openclaude/Claude-Code traffic that does NOT strictly
  alternate user/assistant.

  Differences vs. the stock Mixtral tokenizer template:
    * The stock template raises 400 on consecutive same-role turns and rejects
      any role other than user/assistant. We coalesce same-role runs and
      handle system + tool roles natively.
    * `system` content is concatenated and prepended to the FIRST user [INST]
      block (Mistral has no dedicated system tag).
    * `assistant.tool_calls` → `[TOOL_CALLS] [ {...}, {...} ] </s>`
    * `role == "tool"` → `[TOOL_RESULTS] {"call_id":"...","content":"..."} [/TOOL_RESULTS]`
      (consecutive tool messages are joined into one results array.)
    * `content` may be a string OR an OpenAI-style list of parts; both render.
-#}
{%- macro flatten(c) -%}
{%- if c is string -%}{{ c }}
{%- elif c is iterable -%}
{%- for p in c -%}
{%- if p is mapping -%}{{ p.get('text', p.get('content', '')) }}
{%- else -%}{{ p }}
{%- endif -%}
{%- if not loop.last %}

{% endif -%}
{%- endfor -%}
{%- else -%}{{ c|string }}
{%- endif -%}
{%- endmacro -%}
{{ bos_token }}
{%- set ns = namespace(sys_buf='', pending_user='', need_inst_open=true, last_role='') -%}
{#- First pass-ish: walk messages, coalescing consecutive same-role turns. -#}
{%- for message in messages -%}
    {%- set role = message['role'] -%}
    {%- set content_str = flatten(message.get('content') or '') -%}

    {%- if role == 'system' -%}
        {#- Stash system content; it gets prepended to the next user turn. -#}
        {%- if ns.sys_buf -%}{%- set ns.sys_buf = ns.sys_buf + '\n\n' + content_str -%}
        {%- else -%}{%- set ns.sys_buf = content_str -%}{%- endif -%}

    {%- elif role == 'user' -%}
        {#- If we just emitted an assistant turn, close it & open new [INST]. -#}
        {%- if ns.last_role == 'assistant' or ns.last_role == 'tool' -%}
            {%- set ns.need_inst_open = true -%}
        {%- endif -%}
        {%- if ns.need_inst_open -%}
            {{ '[INST] ' }}
            {%- if ns.sys_buf -%}{{ ns.sys_buf }}{{ '\n\n' }}{%- set ns.sys_buf = '' -%}{%- endif -%}
            {{ content_str }}
            {%- set ns.need_inst_open = false -%}
        {%- else -%}
            {#- Coalesce: append to the currently-open [INST]. -#}
            {{ '\n\n' }}{{ content_str }}
        {%- endif -%}
        {%- set ns.last_role = 'user' -%}

    {%- elif role == 'assistant' -%}
        {#- Close any open [INST] before assistant text. -#}
        {%- if not ns.need_inst_open and ns.last_role == 'user' -%}
            {{ ' [/INST]' }}
            {%- set ns.need_inst_open = true -%}
        {%- endif -%}
        {%- set tcs = message.get('tool_calls') or [] -%}
        {%- if tcs -%}
            {{ '[TOOL_CALLS] [' }}
            {%- for tc in tcs -%}
                {%- set fn = tc.get('function') or {} -%}
                {%- set fn_name = fn.get('name','') -%}
                {%- set fn_args = fn.get('arguments','') -%}
                {%- if fn_args is string -%}
                    {{ '{"name": "' ~ fn_name ~ '", "arguments": ' ~ fn_args ~ ', "id": "' ~ tc.get('id','') ~ '"}' }}
                {%- else -%}
                    {{ '{"name": "' ~ fn_name ~ '", "arguments": ' ~ (fn_args|tojson) ~ ', "id": "' ~ tc.get('id','') ~ '"}' }}
                {%- endif -%}
                {%- if not loop.last %}, {% endif -%}
            {%- endfor -%}
            {{ ']' }}
            {%- if content_str -%}{{ '\n\n' }}{{ content_str }}{%- endif -%}
        {%- else -%}
            {#- Coalesce text assistants: separate with \n\n. -#}
            {%- if ns.last_role == 'assistant' -%}{{ '\n\n' }}{%- endif -%}
            {{ content_str }}
        {%- endif -%}
        {%- if loop.last -%}
            {#- Don't emit eos_token if this is the open assistant prompt slot. -#}
            {%- if not add_generation_prompt -%}{{ eos_token }}{%- endif -%}
        {%- else -%}{{ eos_token }}{%- endif -%}
        {%- set ns.last_role = 'assistant' -%}

    {%- elif role == 'tool' -%}
        {#- Tool results: open a [TOOL_RESULTS] block; coalesce consecutive. -#}
        {%- if ns.last_role != 'tool' -%}
            {#- Close any dangling user [INST] first. -#}
            {%- if not ns.need_inst_open and ns.last_role == 'user' -%}
                {{ ' [/INST]' }}{%- set ns.need_inst_open = true -%}
            {%- endif -%}
            {{ '[TOOL_RESULTS] [' }}
        {%- else -%}{{ ', ' }}{%- endif -%}
        {{ '{"call_id": "' ~ message.get('tool_call_id','') ~ '", "content": ' ~ (content_str|tojson) ~ '}' }}
        {#- Peek ahead: if next message is not 'tool', close the block. -#}
        {%- set next_is_tool = false -%}
        {%- if not loop.last -%}
            {%- if loop.nextitem and loop.nextitem.get('role') == 'tool' -%}{%- set next_is_tool = true -%}{%- endif -%}
        {%- endif -%}
        {%- if not next_is_tool -%}{{ '] [/TOOL_RESULTS]' }}{%- endif -%}
        {%- set ns.last_role = 'tool' -%}
    {%- endif -%}
{%- endfor -%}
{#- If the loop ended with an open user [INST] (because no trailing assistant
    arrived yet — i.e. we are at the generation prompt boundary), close it. -#}
{%- if not ns.need_inst_open -%}{{ ' [/INST]' }}{%- endif -%}
{#- Stray system messages with no user after them: emit as a bare [INST]. -#}
{%- if ns.sys_buf -%}{{ '[INST] ' }}{{ ns.sys_buf }}{{ ' [/INST]' }}{%- endif -%}
