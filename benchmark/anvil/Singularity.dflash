Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.01-py3

# Singularity definition file for the Anvil DFlash benchmark image.
#
# Build (on Anvil login node, NOT compute node — login has internet access):
#   module load singularity
#   singularity build $SCRATCH/skill_dflash.sif benchmark/anvil/Singularity.dflash
#
# This bakes vLLM PR #40898 (DFlash drafts: Qwens + Llama-8B) on top of NGC's
# pytorch:25.01 image. Use Singularity.dflash_gemma for the Gemma variant
# (PR #41703) — those need a separate image because the two PRs touch the
# same files and can't co-exist.
#
# Why NGC pytorch:25.01 as base:
#   - CUDA 12.6 toolkit pre-installed (PR #40898 build needs CUDA 12+).
#   - PyTorch 2.6+ (vLLM 0.20+ tested against it).
#   - libstdc++ shipped is GCC 13+ → CXXABI_1.3.15 satisfied (the runtime
#     issue we hit on sunlab is NOT a problem here).
#   - flash-attn already installed.
#
# Caveat: the in-image vLLM source build is NOT bandwidth-light (~5 GB of
# downloads + 30-40 min compile). Singularity builds run on the login node;
# Anvil login is internet-connected, so the build itself is OK there.
#
# After build, compute jobs see the image as a single read-only filesystem.

%post
    set -eux
    # NGC pytorch:25.01-py3 ships a Debian 12 / Python 3.12 stack carrying
    # PEP 668's EXTERNALLY-MANAGED marker. uv pip install --system refuses
    # to write into a marked interpreter (pip itself only warns under root).
    # Removing the marker is the standard NGC-image workaround; we own the
    # rootfs so this is safe.
    rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

    # Compile parallelism: Anvil login node = 32 cores / 503 GB RAM SHARED
    # with other users. Empirically, even MAX_JOBS=8 OOM-killed cmake at
    # peak compile pressure (cmake exit 9 = SIGKILL from kernel) when other
    # users were active. MAX_JOBS=4 is the conservative safe value the
    # original recipe used; with the nightly torch + 2-arch pin below, the
    # build still finishes in ~50-70 min wall-time.
    export MAX_JOBS=4
    export NVCC_THREADS=1
    export CMAKE_BUILD_PARALLEL_LEVEL=4
    # Pin GPU archs to what Anvil actually has — A100 (sm_80) and H100
    # (sm_90). Without this, vLLM compiles every kernel for compute_75/
    # 86/89/90/100 (Turing through Blackwell), ~3× more work for archs
    # we'll never run on. If Anvil adds L40S/L40 or H200 partitions later,
    # widen this list and rebuild.
    export TORCH_CUDA_ARCH_LIST="8.0;9.0"

    # uv is the recommended installer per the DFlash README.
    pip install --no-cache-dir -U uv

    # Build deps for vllm's source build. NGC pytorch:25.01 has most of
    # these, but pin them explicitly so --no-build-isolation has a complete
    # set even if a future NGC base image trims its build chain.
    pip install --no-cache-dir -U \
        "setuptools>=64" wheel packaging ninja cmake "setuptools-scm[toml]>=8"

    # EDIT-TAG: dflash-cu128-fix (2026-05)
    # PyTorch STABLE 2.11.0+cu128 — vLLM PR #40898's requirements/cuda.txt
    # pins exactly `torch==2.11.0` (+ torchvision==0.26.0, torchaudio==2.11.0).
    # Previously we forced a 2.13.0.dev nightly+cu126; uv's resolver then
    # rejected vllm because vllm's own requirements asked for 2.11.0 while
    # our constraint demanded 2.13.0.dev (ResolutionImpossible).
    #
    # cu128 wheels run on Anvil's H100s: the host driver exposes CUDA 12.6
    # (cuda-bindings + libcuda.so.1 from /usr/lib64), and CUDA is backward-
    # compatible across minor versions within 12.x — a binary built against
    # cu128 toolkit headers loads fine on a 12.6 driver.
    #
    # On Float8_e4m3fnuz.h: the header reorganization landed in torch 2.8,
    # so any 2.8+ release (including 2.11.0 stable) has it; the nightly was
    # only needed because we were chasing 2.13.0.dev for an unrelated reason.
    pip install --no-cache-dir -U \
        --index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple/ \
        torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0

    # Capture the EXACT torch version we just installed and write it to a
    # constraints file. Every subsequent `pip install` below passes
    # `-c $TORCH_CONSTRAINTS` so any transitive dep that wants a different
    # torch (e.g. onnxruntime pulling cu130 torch from pypi via the regular
    # index) is refused with a ResolutionImpossible error — catching drift
    # at its origin instead of after the build is poisoned.
    #
    # IMPORTANT: pin only the base version "torch==2.11.0" (without the
    # +cu128 local suffix). PEP 440 local-version segments make resolver
    # behavior brittle — uv's resolver will refuse to match vllm's
    # `torch==2.11.0` requirement against a constraint of
    # `torch==2.11.0+cu128` (treated as a stricter pin that no published
    # vllm-required torch can satisfy). The base-version pin keeps cu128
    # in place (it's already installed) without blocking the resolver.
    export TORCH_VERSION="$(python -c 'import torch; print(torch.__version__)')"
    # Strip the +cu128 local-version suffix via bash (avoids nested-quote
    # escaping issues that previously made TORCH_BASE_VERSION empty).
    export TORCH_BASE_VERSION="${TORCH_VERSION%%+*}"
    export TORCH_CONSTRAINTS=/tmp/torch_constraints.txt
    cat > "$TORCH_CONSTRAINTS" <<EOF
torch==${TORCH_BASE_VERSION}
EOF
    echo "torch installed:  ${TORCH_VERSION}"
    echo "torch pinned to:  ${TORCH_BASE_VERSION} (base version, allows local-suffix variants)"
    cat "$TORCH_CONSTRAINTS"

    # Verify the assertion passes RIGHT NOW (immediately after install),
    # so any subsequent drift can be unambiguously attributed to the
    # following step rather than to the initial install.
    python -c "
import torch
v = torch.__version__
assert '+cu128' in v or '+cu126' in v or '.dev' in v, f'torch version unexpected: {v}'
print('torch ok (post-initial-install):', v)
"

    # PR #40898 covers: Qwen3.6-27B-DFlash, Qwen3.6-35B-A3B-DFlash,
    # Qwen3-Coder-30B-A3B-DFlash, LLaMA-3.1-8B-Instruct-DFlash-UltraChat.
    # For Gemma drafts, build the *_gemma image instead (PR #41703).
    #
    # --no-build-isolation makes vLLM's setup.py compile against the
    # nightly torch we just installed (instead of an isolated build-venv
    # torch that uv would pick separately and which previously crashed at
    # import with `_dlpack_exchange_api` missing).
    # No -U so uv keeps the nightly torch instead of trying to upgrade it
    # to whatever torch satisfies vLLM's torch>=X.Y lower bound (which is
    # ambiguous and previously resolved to a stable cu13 wheel).
    # --constraint enforces the exact nightly torch pin we just captured.
    uv pip install --system --no-build-isolation \
        --constraint "$TORCH_CONSTRAINTS" \
        "vllm @ git+https://github.com/vllm-project/vllm.git@refs/pull/40898/head"

    python -c "
import torch
v = torch.__version__
assert '+cu128' in v or '+cu126' in v or '.dev' in v, f'torch version drifted after vllm install: {v}'  # EDIT-TAG: dflash-cu128-fix
print('torch ok (post-vllm):', v)
"

    # Project deps that vast.ai bootstrap installs at job start.
    # CRITICAL: --no-deps for sentence-transformers — without this, pip's
    # dep resolver downgrades our nightly torch to a stable torch (whose
    # C++ ABI doesn't match the vllm._C.abi3.so we just compiled), making
    # `import vllm._C` fail at runtime with an undefined `c10::headeronly::Tag`
    # symbol. Sentence-transformers's other deps (huggingface-hub, tqdm,
    # scikit-learn, scipy) are already pulled in by vllm or torch above.
    pip install --no-cache-dir --no-deps \
        -c "$TORCH_CONSTRAINTS" \
        chromadb sentence-transformers \
        fastapi uvicorn httpx \
        pydantic \
        anthropic \
        openai

    python -c "
import torch
v = torch.__version__
assert '+cu128' in v or '+cu126' in v or '.dev' in v, f'torch version drifted after --no-deps step: {v}'  # EDIT-TAG: dflash-cu128-fix
print('torch ok (post-no-deps):', v)
"

    # Pull in the few transitive deps we still need that aren't covered
    # by --no-deps. The `-c $TORCH_CONSTRAINTS` is what was missing before:
    # onnxruntime's wheel deps + sentence-transformers's transitive
    # PyPI-resolved deps pulled cu130 torch silently. With the constraint
    # file, any resolver path that would upgrade torch hard-fails the
    # install instead of poisoning the build.
    pip install --no-cache-dir \
        -c "$TORCH_CONSTRAINTS" \
        starlette anyio sniffio click h11 httpcore httpx-sse \
        python-multipart jiter typing-inspection email-validator \
        kubernetes onnxruntime mmh3 tenacity opentelemetry-api \
        opentelemetry-sdk opentelemetry-exporter-otlp-proto-grpc \
        pypika orjson pyproject_hooks build durationpy \
        bcrypt requests-oauthlib oauthlib importlib-resources \
        flatbuffers prometheus-fastapi-instrumentator scikit-learn

    # Final verification — torch must still be the cu128 stable we installed.
    # Guards against future recipe changes accidentally swapping torch under vllm.
    python -c "
import torch
v = torch.__version__
assert '+cu128' in v or '+cu126' in v or '.dev' in v, f'torch version drifted: {v}'  # EDIT-TAG: dflash-cu128-fix
print('torch ok:', v)
"

    # ---- openclaude (the vllm-talking Claude Code CLI) ----
    # Installed exactly as bootstrap_vastai_tp.sh:454-498 does it: Node 22.11.0
    # tarball + npm-install pinned 0.8.0 + max_tokens patch + openclaude-vllm
    # wrapper. Without this, run_benchmark.py's `claude -p ...` subprocess
    # can't find a CLI and the trial fails before any tokens are generated.
    curl -fsSL https://nodejs.org/dist/v22.11.0/node-v22.11.0-linux-x64.tar.xz \
        -o /tmp/node.tar.xz
    tar -xJf /tmp/node.tar.xz -C /opt/
    rm /tmp/node.tar.xz
    for b in node npm npx; do
        ln -sf /opt/node-v22.11.0-linux-x64/bin/$b /usr/local/bin/$b
    done
    # Pin openclaude 0.8.0 — 0.9.1 broke -p prompt mode (vast.ai memory).
    npm install -g --prefix /opt/node-v22.11.0-linux-x64 \
        @gitlawb/openclaude@0.8.0 --no-audit --no-fund
    OC_CLI=/opt/node-v22.11.0-linux-x64/lib/node_modules/@gitlawb/openclaude/dist/cli.mjs
    sed -i \
        -e "s/MAX_OUTPUT_TOKENS_DEFAULT = 32000/MAX_OUTPUT_TOKENS_DEFAULT = 8000/g" \
        -e "s/MAX_OUTPUT_TOKENS_UPPER_LIMIT = 64000/MAX_OUTPUT_TOKENS_UPPER_LIMIT = 8000/g" \
        -e "s/ESCALATED_MAX_TOKENS = 64000/ESCALATED_MAX_TOKENS = 8000/g" \
        "$OC_CLI"
    ln -sf /opt/node-v22.11.0-linux-x64/bin/openclaude /usr/local/bin/openclaude
    cat > /usr/local/bin/openclaude-vllm <<'WRAP'
#!/bin/bash
exec /usr/local/bin/openclaude --provider openai "$@"
WRAP
    chmod +x /usr/local/bin/openclaude-vllm

    # Sanity checks — fail the build if any expected binary won't run.
    # NOTE: skip `import vllm._C` — that pulls in libcuda.so.1 which is
    # provided by the NVIDIA driver, not the container. Apptainer's
    # build/fakeroot context has no driver, so the import fails even
    # though the .sif works fine on a GPU compute node (where --nv
    # injects the host driver). Just verify vllm's pure-Python entry.
    python -c "import vllm; print('vllm', vllm.__version__)"
    /usr/local/bin/openclaude --version
    test -x /usr/local/bin/openclaude-vllm

%environment
    # Silence HF telemetry; default cache to scratch (overridable per-job).
    export HF_HUB_DISABLE_TELEMETRY=1
    export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
    # Speed up huggingface downloads.
    export HF_HUB_ENABLE_HF_TRANSFER=1

%labels
    Author rf-sim-agent-v2
    Version 1.0
    BaseImage nvcr.io/nvidia/pytorch:25.01-py3
    vLLM_PR 40898
    DFlashFamily qwen-llama
