Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.01-py3

# Baseline image v2 — same intent as Singularity.baseline but with newer
# flash-attn so Granite-4.0-tiny-preview and Gemma-3-27B-it load successfully.
#
# Root cause for the v2 rebuild (2026-05):
#   - v1 baseline.sif uses vllm==0.10.0 (PyPI wheel) which ships flash-attn
#     2.4.2.dev3 from the NGC pytorch:25.01 base layer.
#   - vllm 0.10.0's GraniteMoeHybrid path imports xformers.ops.fmha.flash,
#     and that module hard-checks for flash-attn >=2.7.1,<=2.8.0 at import.
#     On the v1 image we hit:
#       ImportError: Requires Flash-Attention version >=2.7.1,<=2.8.0
#                    but got 2.4.2.dev3.
#     (See /anvil/scratch/$USER/skill/logs/vllm_17321714.log line 95.)
#   - Gemma-3-27B-it: vLLM 0.10.0 already has gemma3 support in
#     models/gemma3.py — the only Gemma-3 failure in our logs was a gated
#     HF repo error during download (unrelated to image contents).
#
# Strategy: keep vllm 0.10.0 + torch 2.7+cu126 (proven stable on Anvil
# A100/H100), but force-install flash-attn 2.7.4.post1 (a pre-built wheel
# in flash-attn's range 2.7.1..2.8.0) so xformers stops rejecting it.
#
# Why not bump vllm to 0.11.x: the v1 recipe comment notes 0.11.2 hangs on
# import on Anvil's CUDA-13-driver A100 nodes. Staying on 0.10.0 minimizes
# the blast radius for this rebuild.
#
# Build:
#   sbatch benchmark/anvil/build_baseline_v2_via_sbatch.sh
#
# Output:
#   /anvil/scratch/$USER/skill_baseline_v2.sif   (~16 GB)

%post
    set -eux
    # NGC pytorch:25.01 ships PEP 668 EXTERNALLY-MANAGED marker; uv refuses
    # to install --system without it removed (pip just warns under root).
    rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

    # Pin compile parallelism just in case flash-attn falls back to source.
    # The flash-attn==2.7.4.post1 wheel index has cp312 + torch 2.7 + cu12
    # variants, so this should be a wheel install, but be defensive.
    export MAX_JOBS=4
    export NVCC_THREADS=1
    export CMAKE_BUILD_PARALLEL_LEVEL=4
    export TORCH_CUDA_ARCH_LIST="8.0;9.0"

    # uv is faster than pip for resolution+install; use it for vllm.
    pip install --no-cache-dir -U uv

    # Mainline vLLM from PyPI — pre-built wheel, no source compile.
    # Pin 0.10.0 because vllm 0.11.2 (latest) hangs on import on Anvil's
    # CUDA-13-driver A100 nodes (see Singularity.baseline comment).
    # 0.10.0 ships torch 2.7+cu126 which matches the toolkit cleanly.
    uv pip install --system --only-binary=:all: vllm==0.10.0

    # Capture torch version so we can pin flash-attn against it.
    export TORCH_VERSION="$(python -c 'import torch; print(torch.__version__)')"
    echo "torch installed by vllm 0.10.0: ${TORCH_VERSION}"

    # ---- flash-attn upgrade (the whole point of v2) ----
    # vllm 0.10.0 → xformers → flash.py requires flash-attn in [2.7.1, 2.8.0].
    # 2.7.4.post1 is the latest in that range with broad pre-built wheel
    # coverage on PyPI (cp312, torch 2.7, cu12.x). Install with
    # --no-build-isolation so it links against the SAME torch vllm 0.10.0
    # just installed — without this, pip's build env would pick a
    # different torch, build an ABI-incompatible .so, and runtime import
    # would fail with undefined-symbol errors.
    # --no-deps because all flash-attn's runtime deps (torch, einops,
    # packaging) are already satisfied by the vllm install above.
    # We use plain pip here (not uv) because uv pip install was observed
    # to drop --no-build-isolation under some resolver paths.
    pip install --no-cache-dir --no-build-isolation --no-deps \
        "flash-attn==2.7.4.post1"

    # Verify both vllm's PyPI wheel and our flash-attn upgrade landed.
    python -c "
import flash_attn, vllm
fa = flash_attn.__version__
vv = vllm.__version__
print('flash_attn:', fa)
print('vllm:      ', vv)
# Hard-assert the version is in xformers' accepted range, so any drift
# (e.g., a transitive --no-deps install pulling a stale flash-attn) fails
# the build instead of the runtime.
parts = tuple(int(x) for x in fa.split('.')[:3] if x.isdigit())
assert parts >= (2, 7, 1), f'flash-attn too old: {fa}'
assert parts <= (2, 8, 0), f'flash-attn too new for xformers check: {fa}'
"

    # Project deps. Same pin as Singularity.baseline — vllm 0.10.0 supports
    # transformers 4.56.x but breaks on transformers 5.x (sentence-transformers
    # otherwise resolves to it). Keep the upper bound.
    pip install --no-cache-dir \
        "transformers>=4.56.0,<5" \
        chromadb sentence-transformers \
        fastapi uvicorn httpx \
        pydantic \
        anthropic \
        openai
    # Verify pin took
    python -c "
import transformers
v = transformers.__version__
assert v.startswith('4.'), f'transformers drifted to {v}, should be 4.x'
print('transformers ok:', v)
"

    # Re-verify flash-attn is STILL the upgraded version. sentence-transformers
    # or another dep can sometimes pull a flash-attn revert; if it did, fail
    # the build now rather than at vllm startup on a compute node.
    python -c "
import flash_attn
fa = flash_attn.__version__
parts = tuple(int(x) for x in fa.split('.')[:3] if x.isdigit())
assert parts >= (2, 7, 1), f'flash-attn reverted to {fa} after project deps install'
print('flash_attn still ok after project deps:', fa)
"

    # ---- openclaude (the vllm-talking Claude Code CLI) ----
    # Same install as Singularity.baseline. See that file for per-line comments.
    curl -fsSL https://nodejs.org/dist/v22.11.0/node-v22.11.0-linux-x64.tar.xz \
        -o /tmp/node.tar.xz
    tar -xJf /tmp/node.tar.xz -C /opt/
    rm /tmp/node.tar.xz
    for b in node npm npx; do
        ln -sf /opt/node-v22.11.0-linux-x64/bin/$b /usr/local/bin/$b
    done
    npm install -g --prefix /opt/node-v22.11.0-linux-x64 \
        @gitlawb/openclaude@0.8.0 --no-audit --no-fund
    OC_CLI=/opt/node-v22.11.0-linux-x64/lib/node_modules/@gitlawb/openclaude/dist/cli.mjs
    sed -i \
        -e "s/MAX_OUTPUT_TOKENS_DEFAULT = 32000/MAX_OUTPUT_TOKENS_DEFAULT = 8000/g" \
        -e "s/MAX_OUTPUT_TOKENS_UPPER_LIMIT = 64000/MAX_OUTPUT_TOKENS_UPPER_LIMIT = 8000/g" \
        -e "s/ESCALATED_MAX_TOKENS = 64000/ESCALATED_MAX_TOKENS = 8000/g" \
        "$OC_CLI"
    ln -sf /opt/node-v22.11.0-linux-x64/bin/openclaude /usr/local/bin/openclaude
    cat > /usr/local/bin/openclaude-vllm <<'WRAP'
#!/bin/bash
exec /usr/local/bin/openclaude --provider openai "$@"
WRAP
    chmod +x /usr/local/bin/openclaude-vllm

    # Sanity checks — fail the build if vllm or openclaude won't run.
    python -c "import vllm; print('vllm', vllm.__version__)"
    python -c "import flash_attn; print('flash_attn', flash_attn.__version__)"
    /usr/local/bin/openclaude --version
    test -x /usr/local/bin/openclaude-vllm

%environment
    export HF_HUB_DISABLE_TELEMETRY=1
    export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
    export HF_HUB_ENABLE_HF_TRANSFER=1

%labels
    Author rf-sim-agent-v2
    Version 2.0
    BaseImage nvcr.io/nvidia/pytorch:25.01-py3
    Variant baseline-no-dflash-v2
    Changes flash-attn-2.7.4.post1-for-granite-4.0
