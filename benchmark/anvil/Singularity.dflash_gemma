Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.01-py3

# Sibling of Singularity.dflash for Gemma-4 family (PR #41703 instead of
# #40898). See Singularity.dflash for the rationale and per-line comments.
#
# Build:
#   singularity build $SCRATCH/skill_dflash_gemma.sif \
#       benchmark/anvil/Singularity.dflash_gemma

%post
    set -eux
    # NGC pytorch:25.01-py3 + Python 3.12 ships PEP 668's EXTERNALLY-MANAGED
    # marker; uv pip install --system refuses without it removed. Same
    # rationale as Singularity.dflash.
    rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

    # Compile parallelism + arch pin: see Singularity.dflash for rationale.
    # MAX_JOBS=4 to avoid OOM-kill on shared login node.
    export MAX_JOBS=4
    export NVCC_THREADS=1
    export CMAKE_BUILD_PARALLEL_LEVEL=4
    export TORCH_CUDA_ARCH_LIST="8.0;9.0"

    pip install --no-cache-dir -U uv

    # Build deps for vllm source build (see Singularity.dflash for rationale).
    pip install --no-cache-dir -U \
        "setuptools>=64" wheel packaging ninja cmake "setuptools-scm[toml]>=8"

    # PyTorch nightly (cu126) — see Singularity.dflash. Stable cu126 torch
    # is missing `torch/headeronly/util/Float8_e4m3fnuz.h` that vLLM's
    # CUDA source build #include's; nightly 2.8+ ships it.
    pip install --no-cache-dir --pre -U \
        --index-url https://download.pytorch.org/whl/nightly/cu126 \
        --extra-index-url https://pypi.org/simple/ \
        torch torchvision torchaudio

    # Capture the exact nightly torch and pin it via constraints — see
    # Singularity.dflash for full rationale. Without this, the
    # `onnxruntime mmh3 ...` step below silently upgrades torch to
    # 2.11.0+cu130 from PyPI, blowing ABI match with the freshly compiled
    # vllm._C wheel. The protective assertion only catches drift at the
    # END; we want hard-fail at the originating install step.
    export TORCH_VERSION="$(python -c 'import torch; print(torch.__version__)')"
    export TORCH_CONSTRAINTS=/tmp/torch_constraints.txt
    cat > "$TORCH_CONSTRAINTS" <<EOF
torch==${TORCH_VERSION}
EOF
    echo "torch pinned to: ${TORCH_VERSION}"
    cat "$TORCH_CONSTRAINTS"

    python -c "
import torch
v = torch.__version__
assert '.dev' in v or '+cu126' in v, f'torch version drifted: {v}'
print('torch ok (post-initial-install):', v)
"

    # PR #41703: gemma-4-31B-it-DFlash, gemma-4-26B-A4B-it-DFlash.
    # --no-build-isolation: vLLM compiles against the nightly torch above.
    # --constraint enforces the exact nightly torch pin captured above.
    uv pip install --system --no-build-isolation \
        --constraint "$TORCH_CONSTRAINTS" \
        "vllm @ git+https://github.com/vllm-project/vllm.git@refs/pull/41703/head"

    python -c "
import torch
v = torch.__version__
assert '.dev' in v or '+cu126' in v, f'torch version drifted after vllm install: {v}'
print('torch ok (post-vllm):', v)
"

    # See Singularity.dflash: --no-deps to keep nightly torch in place.
    pip install --no-cache-dir --no-deps \
        -c "$TORCH_CONSTRAINTS" \
        chromadb sentence-transformers \
        fastapi uvicorn httpx \
        pydantic \
        anthropic \
        openai

    python -c "
import torch
v = torch.__version__
assert '.dev' in v or '+cu126' in v, f'torch version drifted after --no-deps step: {v}'
print('torch ok (post-no-deps):', v)
"

    pip install --no-cache-dir \
        -c "$TORCH_CONSTRAINTS" \
        starlette anyio sniffio click h11 httpcore httpx-sse \
        python-multipart jiter typing-inspection email-validator \
        kubernetes onnxruntime mmh3 tenacity opentelemetry-api \
        opentelemetry-sdk opentelemetry-exporter-otlp-proto-grpc \
        pypika orjson pyproject_hooks build durationpy \
        bcrypt requests-oauthlib oauthlib importlib-resources \
        flatbuffers prometheus-fastapi-instrumentator scikit-learn
    python -c "
import torch
v = torch.__version__
assert '.dev' in v or '+cu126' in v, f'torch version drifted: {v}'
print('torch ok:', v)
"

    # openclaude — see Singularity.dflash for the rationale + per-line comments.
    curl -fsSL https://nodejs.org/dist/v22.11.0/node-v22.11.0-linux-x64.tar.xz \
        -o /tmp/node.tar.xz
    tar -xJf /tmp/node.tar.xz -C /opt/
    rm /tmp/node.tar.xz
    for b in node npm npx; do
        ln -sf /opt/node-v22.11.0-linux-x64/bin/$b /usr/local/bin/$b
    done
    npm install -g --prefix /opt/node-v22.11.0-linux-x64 \
        @gitlawb/openclaude@0.8.0 --no-audit --no-fund
    OC_CLI=/opt/node-v22.11.0-linux-x64/lib/node_modules/@gitlawb/openclaude/dist/cli.mjs
    sed -i \
        -e "s/MAX_OUTPUT_TOKENS_DEFAULT = 32000/MAX_OUTPUT_TOKENS_DEFAULT = 8000/g" \
        -e "s/MAX_OUTPUT_TOKENS_UPPER_LIMIT = 64000/MAX_OUTPUT_TOKENS_UPPER_LIMIT = 8000/g" \
        -e "s/ESCALATED_MAX_TOKENS = 64000/ESCALATED_MAX_TOKENS = 8000/g" \
        "$OC_CLI"
    ln -sf /opt/node-v22.11.0-linux-x64/bin/openclaude /usr/local/bin/openclaude
    cat > /usr/local/bin/openclaude-vllm <<'WRAP'
#!/bin/bash
exec /usr/local/bin/openclaude --provider openai "$@"
WRAP
    chmod +x /usr/local/bin/openclaude-vllm

    # Skip `import vllm._C` — needs libcuda.so.1 from host driver, not
    # available in apptainer build/fakeroot context. See Singularity.dflash.
    python -c "import vllm; print('vllm', vllm.__version__)"
    /usr/local/bin/openclaude --version
    test -x /usr/local/bin/openclaude-vllm

%environment
    export HF_HUB_DISABLE_TELEMETRY=1
    export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
    export HF_HUB_ENABLE_HF_TRANSFER=1

%labels
    Author rf-sim-agent-v2
    Version 1.0
    BaseImage nvcr.io/nvidia/pytorch:25.01-py3
    vLLM_PR 41703
    DFlashFamily gemma
