Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.01-py3

# Baseline image — mainline vLLM, no DFlash speculative decoding.
# Used for USE_DFLASH=0 sweeps where the baseline-only benchmark is enough.
#
# Why a separate recipe: Singularity.dflash builds vLLM from PR #40898 source,
# which takes 1-2h of CUDA kernel compile. Mainline vLLM ships pre-built
# wheels on PyPI; install is ~30 seconds. Use this when you don't need the
# speculative-decoding comparison.
#
# Build:
#   sbatch benchmark/anvil/build_image_via_sbatch.sh   # adjust to point here
# or direct:
#   singularity build $SCRATCH/skill_baseline.sif \
#       benchmark/anvil/Singularity.baseline

%post
    set -eux
    # NGC pytorch:25.01 ships PEP 668 EXTERNALLY-MANAGED marker; uv refuses
    # to install --system without it removed (pip just warns under root).
    rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

    # uv is faster than pip for resolution+install; use it for vllm.
    pip install --no-cache-dir -U uv

    # Mainline vLLM from PyPI — pre-built wheel, no source compile.
    # Pin 0.10.0 because vllm 0.11.2 (latest) hangs on import on Anvil's
    # CUDA-13-driver A100 nodes (likely torch 2.9+cu128 / driver mismatch).
    # 0.10.0 ships torch 2.7+cu126 which matches the toolkit cleanly.
    # --only-binary=:all: prevents pip from falling back to source build if
    # version resolution drifts to a wheel-less tag (we hit this with -U).
    uv pip install --system --only-binary=:all: vllm==0.10.0

    # Project deps. CRITICAL: pin transformers to a version vllm 0.10.0
    # supports. Without this, pip resolves sentence-transformers's loose
    # constraint to transformers 5.x where `all_special_tokens_extended`
    # was removed, breaking vllm's tokenizer init at runtime.
    pip install --no-cache-dir \
        "transformers>=4.56.0,<5" \
        chromadb sentence-transformers \
        fastapi uvicorn httpx \
        pydantic \
        anthropic \
        openai
    # Verify pin took
    python -c "
import transformers
v = transformers.__version__
assert v.startswith('4.'), f'transformers drifted to {v}, should be 4.x'
print('transformers ok:', v)
"

    # ---- openclaude (the vllm-talking Claude Code CLI) ----
    # Same install as Singularity.dflash. See that file for per-line comments.
    curl -fsSL https://nodejs.org/dist/v22.11.0/node-v22.11.0-linux-x64.tar.xz \
        -o /tmp/node.tar.xz
    tar -xJf /tmp/node.tar.xz -C /opt/
    rm /tmp/node.tar.xz
    for b in node npm npx; do
        ln -sf /opt/node-v22.11.0-linux-x64/bin/$b /usr/local/bin/$b
    done
    npm install -g --prefix /opt/node-v22.11.0-linux-x64 \
        @gitlawb/openclaude@0.8.0 --no-audit --no-fund
    OC_CLI=/opt/node-v22.11.0-linux-x64/lib/node_modules/@gitlawb/openclaude/dist/cli.mjs
    sed -i \
        -e "s/MAX_OUTPUT_TOKENS_DEFAULT = 32000/MAX_OUTPUT_TOKENS_DEFAULT = 8000/g" \
        -e "s/MAX_OUTPUT_TOKENS_UPPER_LIMIT = 64000/MAX_OUTPUT_TOKENS_UPPER_LIMIT = 8000/g" \
        -e "s/ESCALATED_MAX_TOKENS = 64000/ESCALATED_MAX_TOKENS = 8000/g" \
        "$OC_CLI"
    ln -sf /opt/node-v22.11.0-linux-x64/bin/openclaude /usr/local/bin/openclaude
    cat > /usr/local/bin/openclaude-vllm <<'WRAP'
#!/bin/bash
exec /usr/local/bin/openclaude --provider openai "$@"
WRAP
    chmod +x /usr/local/bin/openclaude-vllm

    # Sanity checks — fail the build if vllm or openclaude won't run.
    python -c "import vllm; print('vllm', vllm.__version__)"
    /usr/local/bin/openclaude --version
    test -x /usr/local/bin/openclaude-vllm

%environment
    export HF_HUB_DISABLE_TELEMETRY=1
    export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
    export HF_HUB_ENABLE_HF_TRANSFER=1

%labels
    Author rf-sim-agent-v2
    Version 1.0
    BaseImage nvcr.io/nvidia/pytorch:25.01-py3
    Variant baseline-no-dflash
