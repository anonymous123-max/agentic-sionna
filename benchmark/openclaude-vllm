#!/bin/bash
# openclaude-vllm — wrapper that forces --provider openai on every call.
#
# Used as CLAUDE_BIN by benchmark/run_benchmark.py. The harness's
# trial/invoke.py does subprocess.run([CLAUDE_BIN, "-p", prompt, "--model", ...]),
# so this wrapper inserts --provider openai without harness changes.
#
# Reason: openclaude defaults to --provider anthropic. For local-LLM
# benchmarking via vLLM (OpenAI-compatible endpoint), we need openai.
#
# Resolution order for the underlying openclaude binary:
#   1. $OPENCLAUDE_BIN env var if set
#   2. `command -v openclaude` (PATH lookup)
# Errors out with exit 127 if neither resolves.

set -e

OC="${OPENCLAUDE_BIN:-$(command -v openclaude || true)}"
if [[ -z "$OC" ]] || [[ ! -x "$OC" ]]; then
    echo "openclaude-vllm: openclaude binary not found." >&2
    echo "  Set OPENCLAUDE_BIN env var, or install: npm install -g @gitlawb/openclaude" >&2
    exit 127
fi

exec "$OC" --provider openai "$@"
